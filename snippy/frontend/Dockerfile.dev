# Local development only — used by docker-compose.yml, not CI.
FROM node:22

WORKDIR /app

COPY package*.json ./

RUN npm ci

RUN npm install -g @angular/cli

COPY . .

RUN chmod +x /app/entrypoint.dev.sh

EXPOSE 4200

ENTRYPOINT ["/bin/sh", "/app/entrypoint.dev.sh"]

RUN chown -R 1000:1000 /app
USER 1000

CMD ["ng", "serve", "--host", "0.0.0.0", "--poll", "1000", "--proxy-config", "proxy.conf.json"]