# Copy to .env at the repo root. PocketBase loads this file via compose env_file.
# Frontend never receives admin, SMTP, or OAuth client secrets.

# PocketBase superuser (Admin UI at http://localhost:8090/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-now

# Public site URL (reset emails, file links, CORS). Local: http://localhost:4200
PB_APP_URL=http://localhost:4200

# Extra CORS origins, comma-separated. localhost:4200 and PB_APP_URL are always
# included. Add LAN IPs if you browse from another machine, e.g.
# http://192.168.1.10:4200
PB_ALLOWED_ORIGINS=

# Optional SMTP (password-reset mail). Leave PB_SMTP_HOST empty to disable.
# Operators can reset passwords in Admin UI or scripts/reset-user-password.sh
PB_SMTP_HOST=
PB_SMTP_PORT=587
PB_SMTP_USER=
PB_SMTP_PASS=
PB_SMTP_FROM=
PB_SMTP_FROM_NAME=Snippy
PB_SMTP_TLS=true

# Optional OAuth. Set both id and secret for a provider to show its login button.
# Callback URL for every provider: {PB_APP_URL}/api/oauth2-redirect
PB_GITHUB_CLIENT_ID=
PB_GITHUB_CLIENT_SECRET=
PB_GOOGLE_CLIENT_ID=
PB_GOOGLE_CLIENT_SECRET=

